# Copy these into Vercel: Project > Settings > Environment Variables.
# For running scripts on your own computer, copy this file to .env and fill it in.

# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key-here

# A long random secret. HakikaSend derives every testnet wallet from it.
# Generate one in PowerShell (see README). Never change it after you start, or old payments lose their keys.
STELLAR_MASTER_SECRET=paste-64-random-hex-characters-here

# Illustrative display rate only. KES shown per 1 test XLM.
DISPLAY_RATE_KES_PER_XLM=40

# Your public site address, no slash at the end
APP_URL=https://your-domain.com

# Resend: resend.com > API Keys
RESEND_API_KEY=re_xxxxxxxx
# Until your domain is verified in Resend, keep onboarding@resend.dev (it only delivers to your own Resend email)
EMAIL_FROM=HakikaSend <onboarding@resend.dev>
